# Sepolia RPC endpoint, for example from Infura
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"

# Use disposable testnet accounts only. Alice is signer 0; Bob is signer 1.
ALICE_PRIVATE_KEY="ALICE_TESTNET_PRIVATE_KEY"
BOB_PRIVATE_KEY="BOB_TESTNET_PRIVATE_KEY"
ALICE_ADDRESS="ALICE_METAMASK_ADDRESS"
BOB_ADDRESS="BOB_METAMASK_ADDRESS"

# The MySimpleToken address deployed in Lab 3 on Sepolia
MST_ADDRESS=""

# Set after deploying this lesson's single HTLC contract
SEPOLIA_SIMPLE_HTLC_ADDRESS=""

# Script values (generate the secret before setting these)
SWAP_PREIMAGE=""
SWAP_HASHLOCK=""
MST_SWAP_ID=""
ETH_SWAP_ID=""
MST_AMOUNT="100"
ETH_AMOUNT="0.001"
TIMELOCK_SECONDS="3600"

# Optional: used only for contract source verification
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
